{
    "name": "msstc4php/vo-base-bundle",
    "description": "Symfony Validator constraints and a bundle for msstc4php/vo-base. (CI profile: optional libraries and CI-only tools)",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "value-object",
        "symfony",
        "validator",
        "bundle",
        "bridge",
        "ddd"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/msstc4php/vo-base"
        },
        {
            "type": "vcs",
            "url": "https://github.com/msstc4php/vo-base-doctrine"
        }
    ],
    "require": {
        "php": ">=8.4",
        "msstc4php/vo-base": "^1.1",
        "symfony/config": "^7.4|^8.0",
        "symfony/dependency-injection": "^7.4|^8.0",
        "symfony/http-kernel": "^7.4|^8.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.6",
        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^2.18|^3.0",
        "doctrine/mongodb-odm": "^2.9",
        "doctrine/mongodb-odm-bundle": "^5.0",
        "doctrine/orm": "^3.3",
        "friendsofphp/php-cs-fixer": "^3.76",
        "infection/infection": "^0.32",
        "msstc4php/vo-base-doctrine": "^1.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": ">=11.0",
        "rector/rector": "^2.1",
        "roave/backward-compatibility-check": "^8.20",
        "roave/security-advisories": "dev-latest",
        "symfony/doctrine-bridge": "^7.4|^8.0",
        "symfony/framework-bundle": "^7.4|^8.0",
        "symfony/property-access": "^7.4|^8.0",
        "symfony/serializer": "^7.4|^8.0",
        "symfony/validator": "^7.4|^8.0"
    },
    "suggest": {
        "symfony/validator": "To validate raw input against value object rules via constraints.",
        "msstc4php/vo-base-doctrine": "To have the bundle register the Doctrine ORM/ODM types as well."
    },
    "autoload": {
        "psr-4": {
            "MSSTC4PHP\\ValueObject\\Bundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MSSTC4PHP\\ValueObject\\Bundle\\Test\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "infection/extension-installer": true
        },
        "sort-packages": true
    },
    "authors": [
        {
            "name": "Maxim Shamaev",
            "email": "maxim.shamaev@gmail.com"
        }
    ],
    "conflict": {
        "msstc4php/vo-base-doctrine-bridge": "*",
        "msstc4symfony/vo-base-bridge": "*",
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^7.4|^8.0"
        },
        "bundle-standard": {
            "runtime": "php84"
        }
    }
}
